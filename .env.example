# Copy this file to `.env` and fill in your key. Never commit `.env` itself.
# The key stays on the host only — it is never sent to guests, logged, or
# returned by any API response (PLAN.md 4.2/4.5).

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides — defaults shown. Kept configurable per PLAN.md 5.1
# instead of hard-coding model names that will change over time.
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_CHAT_MODEL=gemini-2.0-flash
