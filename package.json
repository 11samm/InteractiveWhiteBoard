{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:server:watch": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@tldraw/sync": "5.4.2",
    "@tldraw/sync-core": "5.4.2",
    "better-sqlite3": "11.8.1",
    "hono": "4.13.8",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tldraw": "5.4.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.2",
    "tailwindcss": "4.1.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.3.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
