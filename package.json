{
  "name": "interactive-whiteboard",
  "private": true,
  "version": "0.0.1",
  "description": "LAN-collaborative study whiteboard with durable tldraw rooms, PDF retrieval, and a host-funded Gemini tutor",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:server:watch": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:annotations": "tsx --test shared/annotationSchema.test.ts shared/annotationGeometry.test.ts",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@tldraw/sync": "5.4.2",
    "@tldraw/sync-core": "5.4.2",
    "better-sqlite3": "11.8.1",
    "hono": "4.13.8",
    "lucide-react": "0.487.0",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "7.13.0",
    "tldraw": "5.4.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "4.1.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.3.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
